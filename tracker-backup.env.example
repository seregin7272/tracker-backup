# Скопируйте в tracker-backup.env и заполните. Файл читается как shell: KEY=value, без пробелов вокруг =.

# ID организации Яндекс 360 (Трекер → Администрирование → Организации → идентификатор)
TRACKER_ORG_ID=1234567
# или для организации Yandex Cloud:
# TRACKER_CLOUD_ORG_ID=bpf...

# Лимит запросов в секунду на один токен
TRACKER_RPS=3

# Каталог бекапа; по умолчанию ./backup рядом со скриптом
# TRACKER_BACKUP_OUT=/backup/tracker
